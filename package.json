{
  "name": "verif-360",
  "productName": "Verif 360",
  "version": "1.0.0",
  "description": "Vérifie si la version 360° d'une vidéo YouTube est téléchargeable, puis la prépare pour Meta Quest",
  "main": "src/main.js",
  "author": "Julien",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "net.julien-drochon.verif-360",
    "productName": "Verif 360",
    "artifactName": "verif-360-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "identity": "-",
      "extendInfo": {
        "CFBundleDisplayName": "Vérif 360"
      },
      "artifactName": "verif-360-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Video",
      "artifactName": "verif-360-${version}-linux-x86_64.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Julien-Dr",
        "repo": "video360-downloader"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "verif-360-${version}-windows-installeur.${ext}"
    },
    "portable": {
      "artifactName": "verif-360-${version}-windows-portable.${ext}"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Julien-Dr/video360-downloader.git"
  },
  "homepage": "https://github.com/Julien-Dr/video360-downloader"
}
